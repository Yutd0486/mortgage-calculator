page {
  background: #f0f4f8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}
.container {
  padding: 0 0 40rpx;
}

/* Header */
.header {
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  padding: 48rpx 40rpx 72rpx;
  text-align: center;
}
.header-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.header-title { font-size: 40rpx; font-weight: 700; color: #fff; }
.header-sub { font-size: 24rpx; color: rgba(255,255,255,0.7); margin-top: 8rpx; }

/* Form Card */
.form-card {
  margin: -36rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
}
.form-card:nth-child(3) { margin-top: 0; }

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 4rpx;
}

.form-item { margin-bottom: 28rpx; }
.form-item:last-child { margin-bottom: 0; }

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 12rpx;
}

.input-row {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 84rpx;
}
.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #222;
  background: transparent;
}
.input-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.form-hint {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* Picker */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 84rpx;
}
.picker-val { font-size: 30rpx; color: #222; }
.picker-arrow { font-size: 24rpx; color: #999; }

/* Quick Buttons */
.quick-btns {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}
.quick-btn {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 22rpx;
  color: #1677ff;
  background: #e6f0ff;
  border-radius: 28rpx;
}
.quick-btn.active {
  background: #1677ff;
  color: #fff;
}

/* Strategy */
.strategy-options {
  display: flex;
  gap: 16rpx;
}
.strategy-option {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.strategy-option.active {
  border-color: #1677ff;
  background: #e6f0ff;
}
.strategy-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  margin-right: 12rpx;
  flex-shrink: 0;
  position: relative;
}
.strategy-radio.checked { border-color: #1677ff; }
.strategy-radio.checked::after {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 18rpx; height: 18rpx;
  background: #1677ff;
  border-radius: 50%;
}
.strategy-info { display: flex; flex-direction: column; }
.strategy-title { font-size: 26rpx; font-weight: 600; color: #333; }
.strategy-desc { font-size: 20rpx; color: #999; margin-top: 4rpx; }

/* Calc Button */
.calc-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 28rpx;
  line-height: 88rpx;
}

/* Result Card */
.result-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 0;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
  overflow: hidden;
}

/* Hero: 节省利息 */
.result-hero {
  text-align: center;
  padding: 40rpx 20rpx 36rpx;
  background: linear-gradient(135deg, #e6f0ff 0%, #bae0ff 100%);
}
.hero-label { font-size: 24rpx; color: #0958d9; }
.hero-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #003eb3;
  line-height: 1.2;
  margin: 8rpx 0 4rpx;
}
.hero-unit { font-size: 22rpx; color: #1677ff; }

/* Detail rows */
.result-details { padding: 24rpx 28rpx; }
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.detail-row:last-child { border-bottom: none; }
.highlight-row { background: #f5f9ff; margin: 0 -28rpx; padding: 16rpx 28rpx; }
.detail-label { font-size: 26rpx; color: #666; }
.detail-val { font-size: 26rpx; font-weight: 600; color: #333; }
.detail-val.accent { color: #1677ff; }
.detail-val.green { color: #1677ff; }

/* Compare Table */
.compare-section {
  border-top: 8rpx solid #f5f7fa;
  padding: 24rpx 0 0;
}
.compare-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  padding: 0 28rpx 16rpx;
}
.compare-header {
  display: flex;
  background: #f5f7fa;
  padding: 14rpx 0;
}
.compare-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.compare-row.even { background: #fafafa; }
.col-m {
  width: 140rpx;
  text-align: center;
  font-size: 22rpx;
  color: #666;
}
.col-v {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #333;
}
.compare-header .col-m,
.compare-header .col-v {
  font-weight: 600;
  color: #555;
}
.new-val {
  color: #1677ff;
  font-weight: 600;
}
