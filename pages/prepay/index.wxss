page {
  background: #f0f4f8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 0 0 60rpx;
}

/* ===== Header ===== */
.header {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
}
.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}
.header-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
}

/* ===== Info Card ===== */
.info-card {
  margin: -40rpx 30rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.10);
  display: flex;
  justify-content: space-between;
}
.info-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.info-label {
  font-size: 22rpx;
  color: #999;
}
.info-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

/* ===== Form Card ===== */
.form-card {
  margin: 0 30rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.10);
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.label-icon {
  font-size: 28rpx;
  line-height: 1;
}

.input-row {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
}
.form-input {
  flex: 1;
  font-size: 32rpx;
  color: #222;
  background: transparent;
}
.input-unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 12rpx;
}

.form-hint {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 10rpx;
}

/* Quick Buttons */
.quick-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.quick-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 24rpx;
  color: #52c41a;
  background: #f6ffed;
  border-radius: 30rpx;
  transition: all 0.2s;
}
.quick-btn.active {
  background: #52c41a;
  color: #fff;
}

/* Strategy Options */
.strategy-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.strategy-option {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.strategy-option.active {
  border-color: #52c41a;
  background: #f6ffed;
}
.strategy-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  margin-right: 16rpx;
  position: relative;
}
.strategy-radio.checked {
  border-color: #52c41a;
}
.strategy-radio.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  background: #52c41a;
  border-radius: 50%;
}
.strategy-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.strategy-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.strategy-desc {
  font-size: 22rpx;
  color: #999;
}

/* Calc Button */
.calc-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  border-radius: 48rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  margin-top: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(82,196,26,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.btn-text {
  line-height: 1;
}

/* ===== Result Card ===== */
.result-card {
  margin: 0 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}

.result-summary {
  text-align: center;
  padding: 40rpx 20rpx;
  background: linear-gradient(135deg, #f6ffed 0%, #d9f7be 100%);
  border-radius: 16rpx;
  border: 2rpx solid #b7eb8f;
  margin-bottom: 32rpx;
}
.saved-label {
  font-size: 26rpx;
  color: #389e0d;
  margin-bottom: 8rpx;
}
.saved-num {
  font-size: 60rpx;
  font-weight: 800;
  color: #237804;
  line-height: 1.1;
}
.saved-unit {
  font-size: 24rpx;
  color: #389e0d;
  margin-top: 8rpx;
}

.result-details {
  margin-bottom: 32rpx;
}
.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.detail-item:last-child {
  border-bottom: none;
}
.detail-label {
  font-size: 26rpx;
  color: #666;
}
.detail-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.detail-val.gray {
  color: #999;
}
.detail-val.green {
  color: #52c41a;
}
.detail-val.orange {
  color: #fa8c16;
}

/* Compare Table */
.compare-table {
  margin-top: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #e8e8e8;
}
.compare-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  padding: 20rpx 24rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #e8e8e8;
}
.table-header {
  display: flex;
  background: #f0f4f8;
  padding: 18rpx 0;
}
.table-row {
  display: flex;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.row-even {
  background: #fafafa;
}
.col-month {
  width: 140rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
}
.col-val {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #333;
}
.col-val.highlight {
  color: #52c41a;
  font-weight: 600;
}
.table-header .col-month,
.table-header .col-val {
  font-weight: 600;
  color: #555;
  font-size: 24rpx;
}

/* Header Icon */
.header-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
  display: block;
}