<view class="container">
  <!-- Header -->
  <view class="header">
    <view class="header-icon">💳</view>
    <view class="header-title">提前还款计算</view>
    <view class="header-sub">看看提前还款能省多少利息</view>
  </view>

  <!-- 贷款信息 -->
  <view class="form-card">
    <view class="section-title">贷款信息</view>

    <view class="form-item">
      <view class="form-label">贷款总额</view>
      <view class="input-row">
        <input class="form-input" type="digit" placeholder="请输入金额" bindinput="onLoanAmountInput" value="{{loanAmount}}" />
        <view class="input-unit">万元</view>
      </view>
      <view class="quick-btns">
        <view class="quick-btn {{loanAmount=='50'?'active':''}}" bindtap="setLoan" data-val="50">50万</view>
        <view class="quick-btn {{loanAmount=='100'?'active':''}}" bindtap="setLoan" data-val="100">100万</view>
        <view class="quick-btn {{loanAmount=='150'?'active':''}}" bindtap="setLoan" data-val="150">150万</view>
        <view class="quick-btn {{loanAmount=='200'?'active':''}}" bindtap="setLoan" data-val="200">200万</view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">年利率</view>
      <view class="input-row">
        <input class="form-input" type="digit" placeholder="请输入利率" bindinput="onRateInput" value="{{rate}}" />
        <view class="input-unit">%</view>
      </view>
      <view class="quick-btns">
        <view class="quick-btn {{rate=='3.1'?'active':''}}" bindtap="setRate" data-val="3.1">3.1%</view>
        <view class="quick-btn {{rate=='3.5'?'active':''}}" bindtap="setRate" data-val="3.5">3.5%</view>
        <view class="quick-btn {{rate=='3.95'?'active':''}}" bindtap="setRate" data-val="3.95">3.95%</view>
        <view class="quick-btn {{rate=='4.2'?'active':''}}" bindtap="setRate" data-val="4.2">4.2%</view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">贷款年限</view>
      <picker mode="selector" range="{{years}}" value="{{selectedYearIndex}}" bindchange="onYearsChange">
        <view class="picker-row">
          <text class="picker-val">{{years[selectedYearIndex]}} 年</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
      <view class="quick-btns">
        <view class="quick-btn {{years[selectedYearIndex]==10?'active':''}}" bindtap="setYear" data-val="10">10年</view>
        <view class="quick-btn {{years[selectedYearIndex]==20?'active':''}}" bindtap="setYear" data-val="20">20年</view>
        <view class="quick-btn {{years[selectedYearIndex]==25?'active':''}}" bindtap="setYear" data-val="25">25年</view>
        <view class="quick-btn {{years[selectedYearIndex]==30?'active':''}}" bindtap="setYear" data-val="30">30年</view>
      </view>
    </view>
  </view>

  <!-- 提前还款参数 -->
  <view class="form-card">
    <view class="section-title">提前还款方案</view>

    <view class="form-item">
      <view class="form-label">已还期数</view>
      <view class="input-row">
        <input class="form-input" type="number" placeholder="已还了几期（月）" bindinput="onPrepayMonthInput" value="{{prepayMonth}}" />
        <view class="input-unit">期</view>
      </view>
      <view class="form-hint">例如：已还12期 = 贷款满1年时提前还款</view>
    </view>

    <view class="form-item">
      <view class="form-label">提前还款金额</view>
      <view class="input-row">
        <input class="form-input" type="digit" placeholder="请输入金额" bindinput="onPrepayAmountInput" value="{{prepayAmount}}" />
        <view class="input-unit">万元</view>
      </view>
      <view class="quick-btns">
        <view class="quick-btn {{prepayAmount=='5'?'active':''}}" data-val="5" bindtap="setAmount">5万</view>
        <view class="quick-btn {{prepayAmount=='10'?'active':''}}" data-val="10" bindtap="setAmount">10万</view>
        <view class="quick-btn {{prepayAmount=='20'?'active':''}}" data-val="20" bindtap="setAmount">20万</view>
        <view class="quick-btn {{prepayAmount=='50'?'active':''}}" data-val="50" bindtap="setAmount">50万</view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">还款策略</view>
      <view class="strategy-options">
        <view class="strategy-option {{strategy === 'reducePayment' ? 'active' : ''}}" bindtap="onStrategyChange" data-strategy="reducePayment">
          <view class="strategy-radio {{strategy === 'reducePayment' ? 'checked' : ''}}"></view>
          <view class="strategy-info">
            <view class="strategy-title">降低月供</view>
            <view class="strategy-desc">还款年限不变，每月少还</view>
          </view>
        </view>
        <view class="strategy-option {{strategy === 'reduceTerm' ? 'active' : ''}}" bindtap="onStrategyChange" data-strategy="reduceTerm">
          <view class="strategy-radio {{strategy === 'reduceTerm' ? 'checked' : ''}}"></view>
          <view class="strategy-info">
            <view class="strategy-title">缩短年限</view>
            <view class="strategy-desc">月供不变，提前还清</view>
          </view>
        </view>
      </view>
    </view>

    <button class="calc-btn" bindtap="calculate">计算节省利息</button>
  </view>

  <!-- 计算结果 -->
  <view class="result-card" wx:if="{{result}}">
    <!-- 核心数据：节省利息 -->
    <view class="result-hero">
      <view class="hero-label">预计节省利息</view>
      <view class="hero-num">{{result.savedInterest}}</view>
      <view class="hero-unit">元</view>
    </view>

    <!-- 详细对比 -->
    <view class="result-details">
      <block wx:if="{{result.strategy === 'reducePayment'}}">
        <view class="detail-row">
          <text class="detail-label">原月供</text>
          <text class="detail-val">{{result.originalMonthly}} 元</text>
        </view>
        <view class="detail-row highlight-row">
          <text class="detail-label">新月供</text>
          <text class="detail-val accent">{{result.newMonthly}} 元</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">每月少还</text>
          <text class="detail-val green">{{result.monthlySaved}} 元</text>
        </view>
      </block>
      <block wx:if="{{result.strategy === 'reduceTerm'}}">
        <view class="detail-row">
          <text class="detail-label">原还款期数</text>
          <text class="detail-val">{{result.originalTerms}} 期</text>
        </view>
        <view class="detail-row highlight-row">
          <text class="detail-label">新还款期数</text>
          <text class="detail-val accent">{{result.newTerms}} 期</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">提前还清</text>
          <text class="detail-val green">{{result.savedTimeText}}</text>
        </view>
      </block>
      <view class="detail-row">
        <text class="detail-label">提前还款时剩余本金</text>
        <text class="detail-val">{{result.remainingPrincipal}} 元</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">还款后剩余本金</text>
        <text class="detail-val">{{result.newPrincipal}} 元</text>
      </view>
    </view>

    <!-- 前后对比表 -->
    <view class="compare-section" wx:if="{{compareSchedule.length > 0}}">
      <view class="compare-title">还款前后月供对比</view>
      <view class="compare-header">
        <text class="col-m">期数</text>
        <text class="col-v">原月供</text>
        <text class="col-v">新月供</text>
      </view>
      <view class="compare-row {{index % 2 === 0 ? 'even' : ''}}" wx:for="{{compareSchedule}}" wx:key="month">
        <text class="col-m">第{{item.month}}期</text>
        <text class="col-v">{{item.original}}</text>
        <text class="col-v new-val">{{item.newPayment}}</text>
      </view>
    </view>
  </view>

  <!-- 底部留白 -->
  <view style="height: 40rpx;"></view>
</view>
