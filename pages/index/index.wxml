<view class="container">
  <!-- 顶部 Banner -->
  <view class="header">
    <text class="header-icon">🏠</text>
    <view class="header-title">房贷计算器</view>
    <view class="header-sub">等额本息 vs 等额本金</view>
  </view>

  <!-- 模式切换 Tab -->
  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'normal' ? 'active' : ''}}" bindtap="switchMode" data-mode="normal">
      <text class="tab-text">普通贷款</text>
    </view>
    <view class="mode-tab {{mode === 'combo' ? 'active' : ''}}" bindtap="switchMode" data-mode="combo">
      <text class="tab-text">组合贷款</text>
    </view>
  </view>

  <!-- 输入表单 -->
  <view class="form-card">
    <!-- 普通模式 -->
    <block wx:if="{{mode === 'normal'}}">
      <!-- 贷款总额 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-icon">💰</text>
          <text class="label-text">贷款总额</text>
        </view>
        <view class="input-row">
          <input class="form-input" type="digit" placeholder="请输入金额" bindinput="onLoanAmountInput" value="{{loanAmount}}" />
          <view class="input-unit">万元</view>
        </view>
        <view class="quick-btns">
          <view class="quick-btn {{loanAmount=='50'?'active':''}}" bindtap="setLoan" data-val="50">50万</view>
          <view class="quick-btn {{loanAmount=='100'?'active':''}}" bindtap="setLoan" data-val="100">100万</view>
          <view class="quick-btn {{loanAmount=='150'?'active':''}}" bindtap="setLoan" data-val="150">150万</view>
          <view class="quick-btn {{loanAmount=='200'?'active':''}}" bindtap="setLoan" data-val="200">200万</view>
        </view>
      </view>

      <!-- 贷款年限 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-icon">🗓</text>
          <text class="label-text">贷款年限</text>
        </view>
        <picker mode="selector" range="{{years}}" value="{{selectedYearIndex}}" bindchange="onYearsChange">
          <view class="picker-row">
            <text class="picker-val">{{years[selectedYearIndex]}} 年</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
        <view class="quick-btns">
          <view class="quick-btn {{years[selectedYearIndex]==10?'active':''}}" bindtap="setYear" data-val="10">10年</view>
          <view class="quick-btn {{years[selectedYearIndex]==20?'active':''}}" bindtap="setYear" data-val="20">20年</view>
          <view class="quick-btn {{years[selectedYearIndex]==25?'active':''}}" bindtap="setYear" data-val="25">25年</view>
          <view class="quick-btn {{years[selectedYearIndex]==30?'active':''}}" bindtap="setYear" data-val="30">30年</view>
        </view>
      </view>

      <!-- 年利率 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-icon">📈</text>
          <text class="label-text">年利率</text>
        </view>
        <view class="input-row">
          <input class="form-input" type="digit" placeholder="请输入利率" bindinput="onRateInput" value="{{rate}}" />
          <view class="input-unit">%</view>
        </view>
        <view class="quick-btns">
          <view class="quick-btn {{rate=='3.1'?'active':''}}" bindtap="setRate" data-val="3.1">3.1%</view>
          <view class="quick-btn {{rate=='3.5'?'active':''}}" bindtap="setRate" data-val="3.5">3.5%</view>
          <view class="quick-btn {{rate=='3.95'?'active':''}}" bindtap="setRate" data-val="3.95">3.95%</view>
          <view class="quick-btn {{rate=='4.2'?'active':''}}" bindtap="setRate" data-val="4.2">4.2%</view>
        </view>
      </view>
    </block>

    <!-- 组合贷款模式 -->
    <block wx:if="{{mode === 'combo'}}">
      <!-- 商业贷款 -->
      <view class="form-section-title">商业贷款</view>
      <view class="form-item">
        <view class="form-label">
          <text class="label-icon">🏦</text>
          <text class="label-text">贷款金额</text>
        </view>
        <view class="input-row">
          <input class="form-input" type="digit" placeholder="请输入金额" bindinput="onCommercialAmountInput" value="{{commercialAmount}}" />
          <view class="input-unit">万元</view>
        </view>
        <view class="quick-btns">
          <view class="quick-btn {{commercialAmount=='30'?'active':''}}" bindtap="setCommercialAmount" data-val="30">30万</view>
          <view class="quick-btn {{commercialAmount=='50'?'active':''}}" bindtap="setCommercialAmount" data-val="50">50万</view>
          <view class="quick-btn {{commercialAmount=='70'?'active':''}}" bindtap="setCommercialAmount" data-val="70">70万</view>
          <view class="quick-btn {{commercialAmount=='100'?'active':''}}" bindtap="setCommercialAmount" data-val="100">100万</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">
          <text class="label-icon">📈</text>
          <text class="label-text">年利率</text>
        </view>
        <view class="input-row">
          <input class="form-input" type="digit" placeholder="请输入利率" bindinput="onCommercialRateInput" value="{{commercialRate}}" />
          <view class="input-unit">%</view>
        </view>
        <view class="quick-btns">
          <view class="quick-btn {{commercialRate=='3.5'?'active':''}}" bindtap="setCommercialRate" data-val="3.5">3.5%</view>
          <view class="quick-btn {{commercialRate=='3.8'?'active':''}}" bindtap="setCommercialRate" data-val="3.8">3.8%</view>
          <view class="quick-btn {{commercialRate=='4.2'?'active':''}}" bindtap="setCommercialRate" data-val="4.2">4.2%</view>
          <view class="quick-btn {{commercialRate=='4.9'?'active':''}}" bindtap="setCommercialRate" data-val="4.9">4.9%</view>
        </view>
      </view>

      <!-- 公积金贷款 -->
      <view class="form-section-title">公积金贷款</view>
      <view class="form-item">
        <view class="form-label">
          <text class="label-icon">🏛</text>
          <text class="label-text">贷款金额</text>
        </view>
        <view class="input-row">
          <input class="form-input" type="digit" placeholder="请输入金额" bindinput="onFundAmountInput" value="{{fundAmount}}" />
          <view class="input-unit">万元</view>
        </view>
        <view class="quick-btns">
          <view class="quick-btn {{fundAmount=='20'?'active':''}}" bindtap="setFundAmount" data-val="20">20万</view>
          <view class="quick-btn {{fundAmount=='30'?'active':''}}" bindtap="setFundAmount" data-val="30">30万</view>
          <view class="quick-btn {{fundAmount=='50'?'active':''}}" bindtap="setFundAmount" data-val="50">50万</view>
          <view class="quick-btn {{fundAmount=='60'?'active':''}}" bindtap="setFundAmount" data-val="60">60万</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">
          <text class="label-icon">📈</text>
          <text class="label-text">年利率</text>
        </view>
        <view class="input-row">
          <input class="form-input" type="digit" placeholder="请输入利率" bindinput="onFundRateInput" value="{{fundRate}}" />
          <view class="input-unit">%</view>
        </view>
        <view class="quick-btns">
          <view class="quick-btn {{fundRate=='2.6'?'active':''}}" bindtap="setFundRate" data-val="2.6">2.6%</view>
          <view class="quick-btn {{fundRate=='2.85'?'active':''}}" bindtap="setFundRate" data-val="2.85">2.85%</view>
          <view class="quick-btn {{fundRate=='3.1'?'active':''}}" bindtap="setFundRate" data-val="3.1">3.1%</view>
          <view class="quick-btn {{fundRate=='3.25'?'active':''}}" bindtap="setFundRate" data-val="3.25">3.25%</view>
        </view>
      </view>

      <!-- 共用贷款年限 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-icon">🗓</text>
          <text class="label-text">贷款年限</text>
        </view>
        <picker mode="selector" range="{{years}}" value="{{selectedYearIndex}}" bindchange="onYearsChange">
          <view class="picker-row">
            <text class="picker-val">{{years[selectedYearIndex]}} 年</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
        <view class="quick-btns">
          <view class="quick-btn {{years[selectedYearIndex]==10?'active':''}}" bindtap="setYear" data-val="10">10年</view>
          <view class="quick-btn {{years[selectedYearIndex]==20?'active':''}}" bindtap="setYear" data-val="20">20年</view>
          <view class="quick-btn {{years[selectedYearIndex]==25?'active':''}}" bindtap="setYear" data-val="25">25年</view>
          <view class="quick-btn {{years[selectedYearIndex]==30?'active':''}}" bindtap="setYear" data-val="30">30年</view>
        </view>
      </view>
    </block>

    <button class="calc-btn" bindtap="calculate">
      <text class="btn-text">🧮 立即计算</text>
    </button>
  </view>

  <!-- 结果区域 -->
  <view class="result-card" wx:if="{{showResult}}">
    <!-- 普通模式结果 -->
    <block wx:if="{{mode === 'normal'}}">
      <view class="compare-container">
        <!-- 等额本息 -->
        <view class="result-box box-blue">
          <view class="box-tag">等额本息</view>
          <view class="box-desc">每月固定还款</view>
          <view class="big-num">{{equalPrincipalInterest.monthlyPayment}}</view>
          <view class="big-unit">元/月</view>
          <view class="divider"></view>
          <view class="detail-row">
            <text class="detail-label">总利息</text>
            <text class="detail-val red">{{equalPrincipalInterest.totalInterest}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">还款总额</text>
            <text class="detail-val">{{equalPrincipalInterest.totalAmount}}</text>
          </view>
        </view>

        <!-- 等额本金 -->
        <view class="result-box box-orange">
          <view class="box-tag">等额本金</view>
          <view class="box-desc">月供逐月递减</view>
          <view class="big-num sm">{{equalPrincipal.firstMonthPayment}}</view>
          <view class="big-unit">首月/元</view>
          <view class="range-tip">末月 {{equalPrincipal.lastMonthPayment}} 元</view>
          <view class="divider"></view>
          <view class="detail-row">
            <text class="detail-label">总利息</text>
            <text class="detail-val red">{{equalPrincipal.totalInterest}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">还款总额</text>
            <text class="detail-val">{{equalPrincipal.totalAmount}}</text>
          </view>
        </view>
      </view>

      <!-- 节省提示 -->
      <view class="savings-banner" wx:if="{{savings}}">
        <text class="savings-text">💡 选等额本金可节省利息 </text>
        <text class="savings-num">{{savings}}</text>
        <text class="savings-text"> 元</text>
      </view>

      <!-- 还款明细入口 -->
      <view class="detail-toggle" bindtap="toggleDetail">
        <text class="toggle-text">{{showDetail ? '▲ 收起还款明细' : '▼ 查看还款明细'}}</text>
      </view>

      <!-- 还款明细表 -->
      <view class="detail-table" wx:if="{{showDetail}}">
        <view class="table-header">
          <text class="col-month">期数</text>
          <text class="col-val">等额本息(元)</text>
          <text class="col-val">等额本金(元)</text>
        </view>
        <scroll-view scroll-y style="max-height: 600rpx;">
          <view class="table-row {{index%2==0?'row-even':''}}" wx:for="{{schedule}}" wx:key="month">
            <text class="col-month">第{{item.month}}期</text>
            <text class="col-val">{{item.ei}}</text>
            <text class="col-val">{{item.ep}}</text>
          </view>
        </scroll-view>
      </view>
    </block>

    <!-- 组合贷款模式结果 -->
    <block wx:if="{{mode === 'combo' && comboResult}}">
      <view class="combo-result">
        <view class="combo-total">
          <view class="combo-total-label">合计月供</view>
          <view class="combo-total-num">{{comboResult.totalMonthly}}</view>
          <view class="combo-total-unit">元/月</view>
        </view>

        <view class="combo-detail">
          <view class="combo-detail-item">
            <text class="combo-detail-label">商业贷款月供</text>
            <text class="combo-detail-val">{{comboResult.commercial.monthly}} 元</text>
          </view>
          <view class="combo-detail-item">
            <text class="combo-detail-label">商业贷款总利息</text>
            <text class="combo-detail-val red">{{comboResult.commercial.interest}} 元</text>
          </view>
          <view class="combo-detail-item">
            <text class="combo-detail-label">公积金贷款月供</text>
            <text class="combo-detail-val">{{comboResult.fund.monthly}} 元</text>
          </view>
          <view class="combo-detail-item">
            <text class="combo-detail-label">公积金贷款总利息</text>
            <text class="combo-detail-val red">{{comboResult.fund.interest}} 元</text>
          </view>
        </view>

        <!-- 对比提示 -->
        <view class="savings-banner" wx:if="{{comboResult.compareMsg}}">
          <text class="savings-text">💡 {{comboResult.compareMsg}}</text>
        </view>
      </view>
    </block>

    <!-- 提前还款入口（仅普通模式显示） -->
    <view class="prepay-entry" wx:if="{{mode === 'normal' && showResult}}">
      <navigator url="/pages/prepay/index" class="prepay-btn">
        <text class="prepay-btn-text">提前还款计算 →</text>
      </navigator>
    </view>
  </view>
</view>